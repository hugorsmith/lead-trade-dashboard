{
  "name": "Lead Trade Dashboard",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "frontend/src/App.jsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; [ -f requirements-dev.txt ] && pip3 install --user -r requirements-dev.txt; npm --prefix frontend ci; echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "server": "npm --prefix frontend run dev -- --host"
  },
  "portsAttributes": {
    "5173": {
      "label": "Dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    5173
  ]
}
